# ---- COSEC (source) ---------------------------------------------------------
COSEC_BASE_URL=http://111.93.87.11:818/cosec/api.svc/v2/template-data
COSEC_TEMPLATE_ID=133
COSEC_FIELD_EMP=userid   # confirmed: COSEC userid IS the ZingHR employee code
COSEC_USERNAME=
COSEC_PASSWORD=
COSEC_TIMEOUT_MS=30000
COSEC_PAGE_SIZE=1000

# ---- ZingHR (target) --------------------------------------------------------
# UAT (swap both to mservices.zinghr.com for production)
ZINGHR_AUTH_URL=https://mservices-uat.zinghr.com/etl/api/v2/Auth/GenerateJWTToken
ZINGHR_SYNC_URL=https://mservices-uat.zinghr.com/etl/api/v2/TNA/SynSwipes
# Docs show `sswp` for UAT and `SSWP` for prod; set per environment.
ZINGHR_API_PERMISSION=sswp
# Client key / client secret from ZingHR 'App Registration'.
ZINGHR_USERNAME=
ZINGHR_PASSWORD=

# Separate phases so "never arrived" is distinguishable from "unknown outcome".
ZINGHR_CONNECT_TIMEOUT_MS=5000
ZINGHR_HEADERS_TIMEOUT_MS=30000
ZINGHR_BODY_TIMEOUT_MS=30000

# ---- Scheduling -------------------------------------------------------------
SCHEDULE=30 0 * * *
TIMEZONE=Asia/Kolkata
SWEEP_DAYS=10           # 22.9% of swipes arrive >24h late; max seen 6.44 days
MAX_DAYS_PER_RUN=5

# ---- Publishing -------------------------------------------------------------
BATCH_SIZE=500          # server hard cap is 5000
CONCURRENCY=1

# ---- Retry ------------------------------------------------------------------
MAX_ATTEMPTS=5
AMBIGUOUS_RETRIES=1
AMBIGUOUS_ALERT_AT=5
QUARANTINE_DAYS=7
STALL_DAYS=3
BACKOFF_BASE_MS=1000
BACKOFF_CAP_MS=60000

# ---- Operations -------------------------------------------------------------
DB_PATH=./sync.db
AUDIT_DIR=./audit
AUDIT_RETENTION_DAYS=90
HEARTBEAT_URL=
REPORT_EMAIL_TO=
ALERT_WEBHOOK_URL=
DRY_RUN=false
ENVIRONMENT=uat
LOG_LEVEL=info
