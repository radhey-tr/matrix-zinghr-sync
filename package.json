{
  "name": "matrix-zinghr-sync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test --test-timeout=15000 test/*.test.ts",
    "run:once": "node --env-file=.env dist/main.js --once",
    "start": "node --env-file=.env dist/main.js",
    "cli": "node --env-file=.env dist/cli.js",
    "doctor": "node --env-file=.env dist/cli.js doctor",
    "status": "node --env-file=.env dist/cli.js status",
    "dev:once": "node --experimental-strip-types --env-file=.env.local src/main.ts --once",
    "dev:cli": "node --experimental-strip-types --env-file=.env.local src/cli.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "croner": "^9.0.0",
    "pino": "^9.5.0",
    "undici": "^7.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.3"
  }
}
