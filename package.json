{
  "name": "matrix-zinghr-sync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "migrate": "node --experimental-strip-types src/db/migrate.ts",
    "run:once": "node --experimental-strip-types src/main.ts --once",
    "start": "node --experimental-strip-types src/main.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "croner": "^9.0.0",
    "pino": "^9.5.0",
    "undici": "^7.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3"
  }
}
